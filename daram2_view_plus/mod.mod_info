{"mod_id": "daram2_view_plus", "name": "View Plus (Integrated)", "author": "daram2", "version": "1.0.0", "description": "Six daram2 View Plus screen upgrades in one mod: Training, Facility, Custom Tier (Champion Info), Roster, Coaching Staff and Recruitment. If a standalone View Plus mod is also enabled, that screen's module turns itself off so nothing runs twice.", "last_updated": "2026-11-25", "dependencies": [{"mod_id": "base", "version": ">=0.7.4, <0.7.5"}]}